{
  "expo": {
    "name": "multiCalc",
    "slug": "multi-calc-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F172A",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.multicalc.kirana",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Live Location Share ke liye aapki location partner ke saath surakshit tareeke se share karne ke liye permission chahiye.",
          "locationAlwaysAndWhenInUsePermission": "Live Location Share ko background mein chalu rakhne ke liye aapki location ki Always permission chahiye. Aap kabhi bhi sharing band kar sakte hain.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2a99ab85-df29-4305-94d4-e16f9636b26f"
      }
    }
  }
}
