# Kharcha Tracker — Family sync (Supabase) configuration
#
# Copy this file to `.env.local` (that name is git-ignored) and paste the two
# values from your Supabase project:
#   Dashboard → Project Settings → API Keys → `anon` public key
#   Dashboard → Project Settings → Data API  → Project URL
#
# Restart the dev server after changing them:  npx expo start -c
#
# Both values are meant to be public — they ship inside the APK. The family
# data stays private because of the Row Level Security policies in
# supabase/schema.sql plus the unguessable 8-character family code.
#
# If these are left empty, cloud sync switches itself off and the app works
# exactly like the offline-only version.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=paste-your-anon-key-here
